{
  "id": "classic_white",
  "name": {
    "en": "White",
    "zh": "经典白框"
  },
  "version": 1,
  "editable": true,
  "layout": {
    "position": "BORDER",
    "height": 80,
    "backgroundColor": "#FFFFFF",
    "padding": 8,
    "borderWidth": 8
  },
  "elements": [
    {
      "type": "logo",
      "logoType": "BRAND",
      "alignment": "START",
      "size": 32,
      "maxWidth": 128,
      "margin": 8,
      "line": -1
    },
    {
      "type": "text",
      "textType": "APERTURE",
      "alignment": "END",
      "fontSize": 16,
      "color": "#333333",
      "fontWeight": "BOLD",
      "line": 0
    },
    {
      "type": "text",
      "textType": "FOCAL_LENGTH_35MM",
      "alignment": "END",
      "fontSize": 16,
      "color": "#333333",
      "fontWeight": "BOLD",
      "line": 0
    },
    {
      "type": "text",
      "textType": "SHUTTER_SPEED",
      "alignment": "END",
      "fontSize": 16,
      "color": "#333333",
      "fontWeight": "BOLD",
      "line": 0
    },
    {
      "type": "text",
      "textType": "ISO",
      "alignment": "END",
      "fontSize": 16,
      "color": "#333333",
      "fontWeight": "BOLD",
      "line": 0
    },
    {
      "type": "text",
      "textType": "DATETIME",
      "alignment": "END",
      "fontSize": 12,
      "color": "#666666",
      "format": "yyyy.MM.dd HH:mm:ss",
      "line": 1
    }
  ]
