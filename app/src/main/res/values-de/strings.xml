    <string name="fotufilm_control_stock">Film</string>
    <string name="fotufilm_control_stock_description">Wählen Sie den Film, mit dem das Foto entwickelt wird.</string>
    <string name="fotufilm_control_gauge">Format</string>
    <string name="fotufilm_control_gauge_description">Legt die Bildgröße auf dem Film fest; sie beeinflusst sichtbares Korn und Lichthöfe.</string>
    <string name="fotufilm_control_grain">Korn</string>
    <string name="fotufilm_control_grain_description">Passt die Kornstärke relativ zum gewählten Film an.</string>
    <string name="fotufilm_control_grainMottle">Mottle</string>
    <string name="fotufilm_control_grainMottle_description">Fügt dem Kornmuster größere, weichere Cluster hinzu.</string>
    <string name="fotufilm_control_filmGrainSize">Korngröße</string>
    <string name="fotufilm_control_filmGrainSize_description">Macht das Korn bei gleicher gemessener Körnigkeit gröber oder feiner.</string>
    <string name="fotufilm_control_filmColourGrain">Farbkorn</string>
    <string name="fotufilm_control_filmColourGrain_description">Mischt das Korn jeder Schicht von unabhängigem Farbrauschen zu einem gemeinsamen Korn.</string>
    <string name="fotufilm_control_filmRedLayer">Rotschicht</string>
    <string name="fotufilm_control_filmRedLayer_description">Skaliert das Korn der rotempfindlichen Schicht im Kornmodell Film.</string>
    <string name="fotufilm_control_filmGreenLayer">Grünschicht</string>
    <string name="fotufilm_control_filmGreenLayer_description">Skaliert das Korn der grünempfindlichen Schicht im Kornmodell Film.</string>
    <string name="fotufilm_control_filmBlueLayer">Blauschicht</string>
    <string name="fotufilm_control_filmBlueLayer_description">Skaliert das Korn der blauempfindlichen Schicht im Kornmodell Film.</string>
    <string name="fotufilm_control_filmScanSoftness">Scan-Weichheit</string>
    <string name="fotufilm_control_filmScanSoftness_description">Liest wie ein weicherer Scan pro Pixel eine größere Filmfläche und glättet das Korn.</string>
    <string name="fotufilm_control_grainModel">Kornmodell</string>
    <string name="fotufilm_control_grainModel_description">Wählt, wie das Filmkorn in der Emulsion entsteht.</string>
    <string name="fotufilm_control_halation">Lichthof</string>
    <string name="fotufilm_control_halation_description">Passt das Leuchten um helle Bereiche an, das durch Reflexion im Film entsteht.</string>
    <string name="fotufilm_control_halationColour">Lichthof-Farbe</string>
    <string name="fotufilm_control_halationColour_description">Steuert, wie stark der Lichthof die Farbe der Lichtquelle behält.</string>
    <string name="fotufilm_control_couplers">Kuppler</string>
    <string name="fotufilm_control_couplers_description">Passt an, wie die Entwicklung Farbtrennung und Kantenkontrast beeinflusst.</string>
    <string name="fotufilm_control_couplerReach">Trennung</string>
    <string name="fotufilm_control_couplerReach_description">Legt fest, wie stark sich benachbarte Filmschichten bei der Entwicklung beeinflussen.</string>
    <string name="fotufilm_control_couplerSelf">Kantenkontrast</string>
    <string name="fotufilm_control_couplerSelf_description">Passt den lokalen Kontrast an Kanten an, der bei der Entwicklung entsteht.</string>
    <string name="fotufilm_control_chromaticFringeAmount">Farbsaum-Stärke</string>
    <string name="fotufilm_control_chromaticFringeAmount_description">Fügt um Kanten einen breiteren Farbeffekt hinzu.</string>
    <string name="fotufilm_control_chromaticFringeRadius">Farbsaum-Radius</string>
    <string name="fotufilm_control_chromaticFringeRadius_description">Legt die Breite des Farbsaums fest. Erfordert eine Farbsaum-Stärke über null.</string>
    <string name="fotufilm_control_push">Push/Pull</string>
    <string name="fotufilm_control_push_description">Länger oder kürzer entwickeln, geschätzt aus der veröffentlichten Push-Kennlinie des Prozesses.</string>
    <string name="fotufilm_control_bleach">Bleach Bypass</string>
    <string name="fotufilm_control_bleach_description">Lässt Silber im Negativ, erhöht den Kontrast und senkt die Sättigung.</string>
    <string name="fotufilm_control_expired">Abgelaufen</string>
    <string name="fotufilm_control_expired_description">Simuliert Film, der bei Raumtemperatur über das Verfallsdatum hinaus gelagert wurde, in Jahren.</string>
    <string name="fotufilm_control_shutter">Langzeitbelichtung</string>
    <string name="fotufilm_control_shutter_description">Legt die Belichtungszeit fest, um die gemessene Langzeitkorrektur des Films anzuwenden.</string>
    <string name="fotufilm_control_cameraPreflash">Kamera-Vorbelichtung</string>
    <string name="fotufilm_control_cameraPreflash_description">Belichtet das Bild vor, um den Schattenkontrast anzuheben.</string>
    <string name="fotufilm_control_paper">Ausgabemedium</string>
    <string name="fotufilm_control_paper_description">Wählt, wie der Film vergrößert, gescannt oder betrachtet wird.</string>
    <string name="fotufilm_control_printLight">Betrachtungslicht</string>
    <string name="fotufilm_control_printLight_description">Wählt das Licht, unter dem der Abzug betrachtet wird.</string>
    <string name="fotufilm_control_printCorrection">Kanalkontrast-Abgleich</string>
    <string name="fotufilm_control_printCorrection_description">Optionale digitale Kanalkontrast-Korrektur, keine Lichtbestimmung.</string>
    <string name="fotufilm_control_printerRed">Rotlicht</string>
    <string name="fotufilm_control_printerRed_description">Printerpunkte; mehr Rotlicht fügt dem Abzug Cyan hinzu.</string>
    <string name="fotufilm_control_printerGreen">Grünlicht</string>
    <string name="fotufilm_control_printerGreen_description">Printerpunkte; mehr Grünlicht fügt dem Abzug Magenta hinzu.</string>
    <string name="fotufilm_control_printerBlue">Blaulicht</string>
    <string name="fotufilm_control_printerBlue_description">Printerpunkte; mehr Blaulicht fügt dem Abzug Gelb hinzu.</string>
    <string name="fotufilm_control_digitalReference">Bildschirmkonvertierung</string>
    <string name="fotufilm_control_digitalReference_description">Wählt, wie entwickelter Film bei Digitaler Referenz umgewandelt wird.</string>
    <string name="fotufilm_control_screenCyan">Cyan / Rot</string>
    <string name="fotufilm_control_screenCyan_description">Positiv fügt durch weniger Rot Cyan hinzu, negativ fügt Rot hinzu.</string>
    <string name="fotufilm_control_screenMagenta">Magenta / Grün</string>
    <string name="fotufilm_control_screenMagenta_description">Positiv fügt durch weniger Grün Magenta hinzu, negativ fügt Grün hinzu.</string>
    <string name="fotufilm_control_screenYellow">Gelb / Blau</string>
    <string name="fotufilm_control_screenYellow_description">Positiv fügt durch weniger Blau Gelb hinzu, negativ fügt Blau hinzu.</string>
    <string name="fotufilm_control_labScanDodging">Abwedeln</string>
    <string name="fotufilm_control_labScanDodging_description">Hält große Lichter zurück und öffnet tiefe Schatten bei Bildern, die weiter als ein Abzug reichen.</string>
    <string name="fotufilm_control_labScanLook">Scanner-Look</string>
    <string name="fotufilm_control_labScanLook_description">Vom neutralen Scan bis zu Farbe und Ton des fertigen Minilab-Scans.</string>
