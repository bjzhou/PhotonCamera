    <string name="settings_accent_color_description">Eine gemeinsame Akzentfarbe für Steuerelemente, Aufnahmeparameter, Aufnahmefortschritt und Profi-Modus festlegen.</string>
    <string name="settings_accent_color_reset">Standard wiederherstellen</string>
