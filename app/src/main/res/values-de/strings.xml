    <string name="settings_raw_color_engine_fotufilm">Fotufilm</string>
    <string name="settings_raw_color_engine_fotufilm_description">Vollständige physikalisch basierte Filmsimulation: spektrale Belichtung, Entwicklung, Korn, Lichthof und Abzug, mit umfassender Labor- und Abzugssteuerung.</string>
