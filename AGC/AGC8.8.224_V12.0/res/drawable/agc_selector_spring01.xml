<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:drawable="@drawable/agc_spring01" />
            <item android:gravity="center" android:height="12.0dp" android:width="12.0dp">
                <bitmap android:gravity="center" android:src="@drawable/agc_icon_checked" />
            </item>
            <item android:gravity="center" android:height="24.0dp" android:width="24.0dp">
                <shape android:shape="rectangle">
                    <stroke android:width="1.0dp" android:color="?colorSecondary" />
                    <corners android:radius="24.0dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:drawable="@drawable/agc_spring01" />
</selector>
