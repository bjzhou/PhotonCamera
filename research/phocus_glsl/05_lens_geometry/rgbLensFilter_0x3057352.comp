vec3 RgbLensInterpolationFastCubic(const in sampler2D inTexture, in vec2 wantedR, in vec2 wantedG,
    in vec2 wantedB, in vec3 factor, in RGBLensParams params, bool greenOnly)
{
    vec3 rgb = vec3(0.0f);
    ivec2 margin = ivec2(params.xMargin, params.yMargin);
    ivec2 imgSize = ivec2(params.xMax, params.yMax);
    if (greenOnly) {
        rgb = InterpolateBicubicRgb(inTexture, imgSize, wantedG, -margin, factor.g).rgb;
    } else {
        rgb.r = InterpolateBicubicRgb(inTexture, imgSize, wantedR, -margin, factor.r).r;
        rgb.g = InterpolateBicubicRgb(inTexture, imgSize, wantedG, -margin, factor.g).g;
        rgb.b = InterpolateBicubicRgb(inTexture, imgSize, wantedB, -margin, factor.b).b;
    }
    return rgb;
}

vec3 RgbLensInterpolationLanczos(const in sampler2D inTexture, in vec2 wantedR, in vec2 wantedG,
    in vec2 wantedB, in vec3 factor, in RGBLensParams params, bool greenOnly)
{
    vec3 rgb = vec3(0.0f);
    ivec2 margin = ivec2(params.xMargin, params.yMargin);
    ivec2 imgSize = ivec2(params.xMax, params.yMax);
    if (greenOnly) {
        rgb = InterpolateLanczosRgb(inTexture, imgSize, wantedG, -margin, factor.g).rgb;
    } else {
        rgb.r = InterpolateLanczosRgb(inTexture, imgSize, wantedR, -margin, factor.r).r;
        rgb.g = InterpolateLanczosRgb(inTexture, imgSize, wantedG, -margin, factor.g).g;
        rgb.b = InterpolateLanczosRgb(inTexture, imgSize, wantedB, -margin, factor.b).b;
    }
    return rgb;
}

void CalculateRGBFactor(in RGBLensParams params, in vec2 pos,
                        inout vec2 wantedG, inout vec4 wantedRB, inout vec3 factor)
{
    vec2 lensPos = pos + vec2(params.xCenterOffset, params.yCenterOffset);
    if (params.doDistortion == 1) {
        wantedG = pos - ApplyParams(lensPos / params.imageScale, params.greenParam, params.greenOffset) * params.imageScale;
    }
    if (params.doAberration == 1) {
        wantedRB.xy = pos - ApplyParams(lensPos / params.imageScale, params.redParam, params.redOffset) * params.imageScale;
        wantedRB.zw = pos - ApplyParams(lensPos / params.imageScale, params.blueParam, params.blueOffset) * params.imageScale;
    }
    if (params.doVignetting == 1) {
        float calcVal = CalculateVignFactor(wantedG + vec2(params.xCenterOffset, params.yCenterOffset), params);
        factor = vec3(calcVal);
    }
    if (params.doVignetting == 1 && params.doAberration == 1) {
        factor.r = CalculateVignFactor(wantedRB.xy + vec2(params.xCenterOffset, params.yCenterOffset), params);
        factor.b = CalculateVignFactor(wantedRB.zw + vec2(params.xCenterOffset, params.yCenterOffset), params);
    }
}

vec4 HtsLookup(const in sampler2D textureMap, in vec2 pos, in ivec2 mapSize)
{
    vec2 maxPos = vec2(mapSize - 1);
    pos = clamp(pos, vec2(0.0f), maxPos);
    ivec2 basePos = ivec2(floor(pos));
    ivec2 basePos1 = clamp(basePos + 1, ivec2(0), ivec2(maxPos));
    vec2 delta = pos - vec2(basePos);
    vec4 p00 = texelFetch(textureMap, basePos, 0);
    vec4 p10 = texelFetch(textureMap, ivec2(basePos1.x, basePos.y), 0);
    vec4 p01 = texelFetch(textureMap, ivec2(basePos.x, basePos1.y), 0);
    vec4 p11 = texelFetch(textureMap, basePos1, 0);
    vec4 h0 = mix(p00, p10, delta.x);
    vec4 h1 = mix(p01, p11, delta.x);
    return mix(h0, h1, delta.y);
}

void CalculateRGBFactorHts(in RGBLensParams params, in vec2 pos, const in sampler2D texMapGV, const in sampler2D texMapRB,
                           inout vec2 wantedG, inout vec4 wantedRB, inout vec3 factor)
{
    ivec2 mapSize = ivec2(params.xMaxMap, params.yMaxMap);
    if (params.doDistortion == 1) {
        wantedG += HtsLookup(texMapGV, pos * params.imageScale, mapSize).xy * params.offsetScale;
    }
    wantedRB = vec4(wantedG, wantedG);
    if (params.doAberration == 1) {
        wantedRB += HtsLookup(texMapRB, pos * params.imageScale, mapSize) * params.offsetScale;
    }
    if (params.doVignetting == 1) {
        factor.g += HtsLookup(texMapGV, wantedG * params.imageScale, mapSize).z * params.vignAmount;
    }
    if (params.doVignetting == 1 && params.doAberration == 1) {
        factor.r += HtsLookup(texMapGV, wantedRB.xy * params.imageScale, mapSize).z * params.vignAmount;
        factor.b += HtsLookup(texMapGV, wantedRB.zw * params.imageScale, mapSize).z * params.vignAmount;
    }
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(uOutputImage);
    if (gid.x >= outSize.x || gid.y >= outSize.y) return;

    vec2 outLocalPos = vec2(gid);

    RGBLensParams params = uParams.params;
    ivec2 marginOffset = ivec2(int(params.xOffset) - params.xMargin, int(params.yOffset) - params.yMargin);
    ivec2 srcPos = ivec2(outLocalPos) + marginOffset;
    vec4 pixelColor = texelFetch(uInputTexture0, srcPos, 0);

    vec2 outGlobalPos = outLocalPos + vec2(float(params.xOffset), float(params.yOffset));

    mat3 mat = mat3(params.matA, params.matB, params.matC);
    vec2 pos = KeystoneTransform(mat, outGlobalPos);
    float alpha = pixelColor.a;

    if (params.blackOutOfBounds == 1 && (any(lessThan(pos, vec2(0.0))) || any(greaterThan(pos, vec2(params.xKeystoneLimit, params.yKeystoneLimit))))) {
        imageStore(uOutputImage, gid, vec4(vec3(0.0), alpha));
        return;
    }

    vec2 wantedG = pos;
    vec4 wantedRB = vec4(pos, pos);
    vec3 factor = vec3(1.0f);

    if (params.doHts == 1) {
        CalculateRGBFactorHts(params, pos, uHtsDistTexture, uHtsAberTexture, wantedG, wantedRB, factor);
    } else {
       CalculateRGBFactor(params, pos, wantedG, wantedRB, factor);
    }

    bool greenOnly = params.doAberration == 0;
    vec3 rgb = vec3(0.0);
    if (uEnableFastMode == 1) {
        rgb = RgbLensInterpolationFastCubic(uInputTexture0, wantedRB.xy, wantedG, wantedRB.zw, factor, params, greenOnly);
    } else {
        rgb = RgbLensInterpolationLanczos(uInputTexture0, wantedRB.xy, wantedG, wantedRB.zw, factor, params, greenOnly);
    }
    imageStore(uOutputImage, gid, vec4(rgb, alpha));
}
