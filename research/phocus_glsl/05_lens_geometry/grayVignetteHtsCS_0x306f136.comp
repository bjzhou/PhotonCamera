    // Calculate input positions for 4 pixels (one packed tile)
    vec2 inPos0 = vec2(4.0 * float(gid.x) + 0.0, float(gid.y)) + vec2(uParams.dstRectLeftTop);
    vec2 inPos1 = vec2(4.0 * float(gid.x) + 1.0, float(gid.y)) + vec2(uParams.dstRectLeftTop);
    vec2 inPos2 = vec2(4.0 * float(gid.x) + 2.0, float(gid.y)) + vec2(uParams.dstRectLeftTop);
