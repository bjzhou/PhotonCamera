    vec2 pos0 = keystoneTransform(uParams.matA, uParams.matB, uParams.matC, inPos0);
    vec2 pos1 = keystoneTransform(uParams.matA, uParams.matB, uParams.matC, inPos1);
    vec2 pos2 = keystoneTransform(uParams.matA, uParams.matB, uParams.matC, inPos2);
    vec2 pos3 = keystoneTransform(uParams.matA, uParams.matB, uParams.matC, inPos3);
    
