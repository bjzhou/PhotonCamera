layout(local_size_x = 16, local_size_y = 16) in;

// Apply gain to pixel value (matching iOS Metal logic)
// Input: half float normalized [0,1]
// Processing: directly in [0,1] space to avoid precision loss
// Output: half float normalized [0,1]
//
// iOS Metal logic (in uint16 space [0,65535]):
//   result = blackLevel + (input - blackLevel) * gain
// Normalized to [0,1]:
//   result_norm = blackLevel_norm + (input_norm - blackLevel_norm) * gain
vec4 ApplyGain(vec4 val, vec4 gain, float blackLevel) {
    // Apply gain directly in normalized [0,1] space
    // v = blackLevel + (val - blackLevel) * gain
    vec4 result = blackLevel + (val - blackLevel) * gain;
    // Clamp to valid range [0,1]
    return clamp(result, 0.0, 1.0);
}

