#version 310 es
precision highp float;
precision highp image2D;

// Input: 16-bit half float texture (PackedBayer, stored as RGBA16F)
layout(rgba16f, binding = 0) readonly uniform image2D uInputImage;
// Output: 16-bit half float texture
layout(rgba16f, binding = 1) writeonly uniform image2D uOutputImage;

// Uniform buffer object for parameters
struct NeutralisationBayerParams {
    vec4 gain;          // RGGB gains (R, G1, G2, B)
    ivec2 margin;       // Texture coordinate margin (pre-divided by 4 for x)
    ivec2 rectOffset;   // rect.left, rect.top for gain index calculation
    float blackLevel;   // Black level offset (normalized to [0,1])
