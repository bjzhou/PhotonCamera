    int yOffset = uParams.params.rectOffset.y & 1;
    int xOffset = uParams.params.rectOffset.x & 1;
    vec4 gainRed = (xOffset == 0) ? uParams.params.gain.xyxy : uParams.params.gain.yxyx;
