    vec2 mapPos = (vec2(srcPos) + uParams.params.offset) * uParams.params.scale;
    vec4 gainRgb = scaleLinear(mapPos, uParams.params.mapSize - ivec2(1));

    result = ApplyGain(val, gainRgb, uParams.params.blackOffset);
    imageStore(uOutputImage, gid, result);
}
