void shiftInts(out vec4 out_vec4, out float out_val, vec4 a, vec4 b, int offset) {
    if (offset == 0) {
        out_vec4 = vec4(a.x, a.y, a.z, a.w);
        out_val = b.x;
    } else if (offset == 1) {
        out_vec4 = vec4(a.y, a.z, a.w, b.x);
        out_val = b.y;
    } else if (offset == 2) {
        out_vec4 = vec4(a.z, a.w, b.x, b.y);
        out_val = b.z;
    } else {
        out_vec4 = vec4(a.w, b.x, b.y, b.z);
        out_val = b.w;
    }
}

