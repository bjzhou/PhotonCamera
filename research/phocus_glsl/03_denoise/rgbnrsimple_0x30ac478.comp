shared vec4 sharedTile[32][32]; // Max tile: (16 + 2*8) = 32

float Luminance(vec4 pix) {
    return pix.r + pix.g + pix.b;
}

vec4 thrCompare(vec4 pix, vec4 pixS, vec4 vecThr) {
    vec4 diff = abs(pix - pixS);
    vec4 compare = step(diff, vecThr);  // step(edge, x): 0.0 if x < edge, else 1.0
    return compare;
}

vec4 CheckPositionFromShared(ivec2 centerLocal, ivec2 offset, vec4 refPix, vec4 compVecThr) {
