            NLMCheckOld s = getCmosCached(pos + ivec2(i, j));

            vec2 grSumRedS     = s.grSumHRed + s.grSumVRed;
            vec2 grAveRedS     = grSumRedS / 4.0;
            vec2 blueAveRedS   = s.blueSumRed / 4.0;
            vec2 lumaRedS      = s.redValRed + grAveRedS + blueAveRedS;
            vec2 grBlueDiffRedS = grSumRedS - s.blueSumRed;
            vec2 redGrDiffRedS  = grAveRedS - s.redValRed;

            bvec4 r0 = bvec4(
                abs(lumaRedS.x      - lumaRedC.x)      <= lumaRThr.x      && abs(grAveRedS.x      - grAveRedC.x)      <= patternGRThr.x  && abs(blueAveRedS.x    - blueAveRedC.x)    <= patternBRThr.x  && abs(grBlueDiffRedS.x - grBlueDiffRedC.x) <= gBDiffRThr.x    && abs(redGrDiffRedS.x  - redGrDiffRedC.x)  <= redGrDiffRThr.x,
                abs(lumaRedS.y      - lumaRedC.y)      <= lumaRThr.y      && abs(grAveRedS.y      - grAveRedC.y)      <= patternGRThr.y  && abs(blueAveRedS.y    - blueAveRedC.y)    <= patternBRThr.y  && abs(grBlueDiffRedS.y - grBlueDiffRedC.y) <= gBDiffRThr.y    && abs(redGrDiffRedS.y  - redGrDiffRedC.y)  <= redGrDiffRThr.y,
                abs(lumaRedS.y      - lumaRedC.x)      <= lumaRThr.x      && abs(grAveRedS.y      - grAveRedC.x)      <= patternGRThr.x  && abs(blueAveRedS.y    - blueAveRedC.x)    <= patternBRThr.x  && abs(grBlueDiffRedS.y - grBlueDiffRedC.x) <= gBDiffRThr.x    && abs(redGrDiffRedS.y  - redGrDiffRedC.x)  <= redGrDiffRThr.x,
                abs(lumaRedS.x      - lumaRedC.y)      <= lumaRThr.y      && abs(grAveRedS.x      - grAveRedC.y)      <= patternGRThr.y  && abs(blueAveRedS.x    - blueAveRedC.y)    <= patternBRThr.y  && abs(grBlueDiffRedS.x - grBlueDiffRedC.y) <= gBDiffRThr.y    && abs(redGrDiffRedS.x  - redGrDiffRedC.y)  <= redGrDiffRThr.y
            );
            if (r0.x) { sumR.x += s.redValRed.x; countR.x += 1.0; }
            if (r0.y) { sumR.y += s.redValRed.y; countR.y += 1.0; }
            if (r0.z) { sumR.x += s.redValRed.y; countR.x += 1.0; }
            if (r0.w) { sumR.y += s.redValRed.x; countR.y += 1.0; }

