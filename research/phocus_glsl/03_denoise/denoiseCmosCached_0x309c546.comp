    vec2 grAveRedC     = grSumRedC / 4.0;
    vec2 blueAveRedC   = c.blueSumRed / 4.0;
    vec2 lumaRedC      = c.redValRed + grAveRedC + blueAveRedC;
    vec2 grBlueDiffRedC = grSumRedC - c.blueSumRed;
    vec2 redGrDiffRedC  = grAveRedC - c.redValRed;

    vec2 redAveG1C   = c.redSumG1  / 2.0;
    vec2 blueAveG1C  = c.blueSumG1 / 2.0;
    vec2 greenAveG1C = c.greenSumG1 / 4.0;
    vec2 lumaG1C     = redAveG1C + c.green1ValG1 + blueAveG1C;
    vec2 grRedDiffG1C  = redAveG1C  - greenAveG1C;
    vec2 grBlueDiffG1C = blueAveG1C - greenAveG1C;

