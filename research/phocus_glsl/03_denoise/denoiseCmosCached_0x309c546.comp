    vec4 p3 = imageLoad(uInputImage3, pos) * 65535.0;

    NLMCheckOld r;
    r.redValRed   = p0.xy * 1.0;
    r.grSumHRed   = p0.zw * 2.0;
    r.grSumVRed   = p1.xy * 2.0;
    r.blueSumRed  = p1.zw * 4.0;
    r.green1ValG1 = p2.xy * 1.0;
    r.redSumG1    = p2.zw * 2.0;
