    if (countG1.x > 1.0) opix.y = round(sumG1.x / countG1.x);
    if (countR.y  > 1.0) opix.z = round(sumR.y  / countR.y);
    if (countG1.y > 1.0) opix.w = round(sumG1.y / countG1.y);

