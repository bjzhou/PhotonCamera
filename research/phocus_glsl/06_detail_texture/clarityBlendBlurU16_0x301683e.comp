#version 310 es
precision highp float;
precision highp int;
precision highp uimage2D;
precision highp image2D;

layout(rgba16ui, binding = 0) readonly  uniform uimage2D uSrc;   // textureA[i] - agg laplacian
layout(rgba16ui, binding = 1) readonly  uniform uimage2D uAux;   // textureG[i] - gaussian
layout(rgba16ui, binding = 2) readonly  uniform uimage2D uAux2;  // textureG[i+1] - gaussian next (half-res)
layout(rgba16ui, binding = 3) readonly  uniform uimage2D uLut;   // 256x256 LUT (U16, not float — IMG GPU compat)
layout(rgba16ui, binding = 4) writeonly uniform uimage2D uDst;

layout(std140, binding = 5) uniform ClarityBlendStuffParams_UBO {
    int wSrc;
    int hSrc;
    float clarityLevel;
    float clarityMax;
    float layerFactor;
    float layerFactorDif;
    float gain;
    float xGamma;
    int blurW;
    int blurH;
    float ba;
    float bb;
    float bc;
    float be;
    float bf;
    float bi;
};

layout(local_size_x = 16, local_size_y = 16) in;

// Returns float4 in [0, 65535] — reads from uAux2 (half-res gaussian)
vec4 readPaddedU16(ivec2 pos, ivec2 pixSize) {
    ivec2 maxPos = ivec2((pixSize.x + 3) / 4, pixSize.y) - 1;
    vec4 val = vec4(imageLoad(uAux2, clamp(pos, ivec2(0), maxPos)));
    if (pos.x >= maxPos.x) {
        int rem = pixSize.x % 4;
        if (rem == 1) val = val.xxxx;
        else if (rem == 2) val = vec4(val.x, val.y, val.y, val.y);
        else if (rem == 3) val = vec4(val.x, val.y, val.z, val.z);
        if (pos.x > maxPos.x)
            val = val.wwww;
    }
    return val;
}

vec4 combineUpscale(vec4 a, vec4 b, ivec2 pos) {
    if ((pos.x & 1) == 1)
        return vec4(a.yzw, b.x);
    else
        return vec4(a.w, b.xyz);
}

vec4 upScaleBlurU16(ivec2 pos) {
    vec4 vs = vec4(0.0);
    ivec2 p = pos / 2;
    int deltaY1 = 1, deltaY2 = 0;

    if ((pos.y & 1) != 0) {
        p.y += 1;
        deltaY1 = -1;
        deltaY2 = (pos.y < 2) ? 0 : deltaY1;
        if (2 * p.y >= blurH) { p.y--; deltaY1 = 0; }
    } else if (pos.y == 0) {
        deltaY1 = 0; deltaY2 = 1;
    } else {
        p.y -= 1;
        deltaY2 = (pos.y < 2 || pos.y + 2 >= blurH) ? 0 : deltaY1;
    }

    ivec2 halfSize = ivec2((blurW + 1) / 2, (blurH + 1) / 2);

    if (pos.x == 0) {
        vec4 tb = readPaddedU16(p, halfSize);
        vs.x = ba*tb.x + bb*tb.x + bc*tb.y;  vs.y = bc*tb.x + bb*tb.x + ba*tb.y;
        vs.z = ba*tb.x + bb*tb.y + bc*tb.z;  vs.w = bc*tb.x + bb*tb.y + ba*tb.z;
        p.y += deltaY1;
        tb = readPaddedU16(p, halfSize);
        vs.x += bb*tb.x + be*tb.x + bf*tb.y;  vs.y += bf*tb.x + be*tb.x + bb*tb.y;
        vs.z += bb*tb.x + be*tb.y + bf*tb.z;  vs.w += bf*tb.x + be*tb.y + bb*tb.z;
        p.y += deltaY2;
        tb = readPaddedU16(p, halfSize);
        vs.x += bc*tb.x + bf*tb.x + bi*tb.y;  vs.y += bi*tb.x + bf*tb.x + bc*tb.y;
        vs.z += bc*tb.x + bf*tb.y + bi*tb.z;  vs.w += bi*tb.x + bf*tb.y + bc*tb.z;
    } else if ((4 * (pos.x + 1) >= blurW) && ((pos.x & 1) == 1)) {
        p.x = (pos.x - 1) / 2;
        vec4 ta = readPaddedU16(p, halfSize);
        vs.x = ba*ta.y + bb*ta.z + bc*ta.w;  vs.y = bc*ta.y + bb*ta.z + ba*ta.w;
        vs.z = ba*ta.z + bb*ta.w + bc*ta.w;  vs.w = bc*ta.z + bb*ta.w + ba*ta.w;
        p.y += deltaY1;
        ta = readPaddedU16(p, halfSize);
        vs.x += bb*ta.y + be*ta.z + bf*ta.w;  vs.y += bf*ta.y + be*ta.z + bb*ta.w;
        vs.z += bb*ta.z + be*ta.w + bf*ta.w;  vs.w += bf*ta.z + be*ta.w + bb*ta.w;
        p.y += deltaY2;
        ta = readPaddedU16(p, halfSize);
        vs.x += bc*ta.y + bf*ta.z + bi*ta.w;  vs.y += bi*ta.y + bf*ta.z + bc*ta.w;
        vs.z += bc*ta.z + bf*ta.w + bi*ta.w;  vs.w += bi*ta.z + bf*ta.w + bc*ta.w;
    } else {
        p.x = (pos.x - 1) / 2;
        vec4 cv = combineUpscale(readPaddedU16(p, halfSize), readPaddedU16(p + ivec2(1, 0), halfSize), pos);
        vs.x = dot(vec3(ba, bb, bc), cv.xyz);  vs.y = dot(vec3(bc, bb, ba), cv.xyz);
        vs.z = dot(vec3(ba, bb, bc), cv.yzw);  vs.w = dot(vec3(bc, bb, ba), cv.yzw);
        p.y += deltaY1;
        cv = combineUpscale(readPaddedU16(p, halfSize), readPaddedU16(p + ivec2(1, 0), halfSize), pos);
        vs.x += dot(vec3(bb, be, bf), cv.xyz);  vs.y += dot(vec3(bf, be, bb), cv.xyz);
        vs.z += dot(vec3(bb, be, bf), cv.yzw);  vs.w += dot(vec3(bf, be, bb), cv.yzw);
        p.y += deltaY2;
        cv = combineUpscale(readPaddedU16(p, halfSize), readPaddedU16(p + ivec2(1, 0), halfSize), pos);
        vs.x += dot(vec3(bc, bf, bi), cv.xyz);  vs.y += dot(vec3(bi, bf, bc), cv.xyz);
        vs.z += dot(vec3(bc, bf, bi), cv.yzw);  vs.w += dot(vec3(bi, bf, bc), cv.yzw);
    }

    return clamp(vs, 0.0, 65535.0);
}

// LUT lookup: input is [0,1], LUT is 256x256, index = floor(val * 65535)
float lookupLut(float val) {
    int idx = int(clamp(val * 65535.0, 0.0, 65535.0));
    ivec2 pos = ivec2(idx & 0xFF, (idx >> 8) & 0xFF);
    return float(imageLoad(uLut, pos).x) / 65535.0;
}

vec4 blendCurveFlt4(vec4 inFlt, float alfa) {
    vec4 res;
    res.x = lookupLut(inFlt.x);
    res.y = lookupLut(inFlt.y);
    res.z = lookupLut(inFlt.z);
    res.w = lookupLut(inFlt.w);
    return (1.0 - alfa) * inFlt + alfa * res;
}

void main() {
    ivec2 gid = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dstSize = imageSize(uDst);
    if (gid.x >= dstSize.x || gid.y >= dstSize.y) return;

    // iOS: float4 lapAgg = float4(int4(src.read(gid)) - 32768) / 65535.0f
    vec4 lapAgg = (vec4(ivec4(imageLoad(uSrc, gid))) - 32768.0) / 65535.0;
    // iOS: ushort4 gauRaw = aux.read(gid)
    uvec4 gauRawU = imageLoad(uAux, gid);
    // iOS: int4 vs = upScaleBlur4(aux2, gid, blnd.blur)
    //      float4 lapRaw = float4(int4(aux.read(gid)) - vs) / 65535.0f
    ivec4 vs = ivec4(upScaleBlurU16(gid));
    vec4 lapRaw = (vec4(ivec4(gauRawU)) - vec4(vs)) / 65535.0;
    // iOS: float4 gauFlt = float4(gauRaw) / 65535.0f
    vec4 gauFlt = vec4(gauRawU) / 65535.0;

    // iOS: float4 val = BlendCurveFlt4(lut, gauFlt, blnd.layerFactorDif)
    vec4 val = blendCurveFlt4(gauFlt, layerFactorDif);
    float d = 1.0 / 65535.0;
    vec4 gauMinus = gauFlt - d;
    vec4 gauPlus = gauFlt + d;
    float sfea = 2.3;
    float sfeb = 10.0;

    // iOS uses per-component conditional via && operator applied to float4
    // In GLSL we must do per-component checks
    vec4 curveAlpha = vec4(0.0);
    for (int c = 0; c < 4; c++) {
        if (gauMinus[c] >= 0.0 && gauPlus[c] <= 1.0) {
            vec4 gp = gauFlt; gp[c] = gauPlus[c];
            vec4 gm = gauFlt; gm[c] = gauMinus[c];
            float curvePlus = blendCurveFlt4(gp, layerFactorDif)[c];
            float curveMinus = blendCurveFlt4(gm, layerFactorDif)[c];
            curveAlpha[c] = max(1.0 - (curvePlus - curveMinus) * (65535.0 / 2.0), 0.0) * sfea;
        }
    }

    // iOS: float4 alpha = min(blnd.clarityMax, blnd.clarityLevel + clamp(sfeb * ((val + d) / (gauFlt + d) - 1.0f) / 2.0f, -1.0f, 1.0f) + curveAlpha)
    vec4 alpha = min(vec4(clarityMax), vec4(clarityLevel) + clamp(sfeb * ((val + d) / (gauFlt + d) - 1.0) / 2.0, -1.0, 1.0) + curveAlpha);
    // iOS: float4 color = (lapRaw*(1.0f - alpha) + lapAgg*alpha) + BlendCurveFlt4(lut, gauFlt, blnd.layerFactor) - gauFlt
    vec4 color = lapRaw * (1.0 - alpha) + lapAgg * alpha + blendCurveFlt4(gauFlt, layerFactor) - gauFlt;

    // iOS: dst.write(ushort4(clamp(color*65535.0f + 32768.0f, 0.0f, 65535.0f)), gid)
    imageStore(uDst, gid, uvec4(clamp(color * 65535.0 + 32768.0, 0.0, 65535.0)));
}
